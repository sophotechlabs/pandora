DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TRUST_PROXY_HEADER=0
# Cookies are marked secure whenever DEBUG is off. Set to 0 only to reach a
# non-TLS instance on a trusted network — a browser drops a secure cookie on http
# and the login silently never sticks.
DJANGO_SECURE_COOKIES=
DATABASE_URL=postgres://pandora:pandora@db:5432/pandora
PANDORA_ENV=local
PANDORA_BASE_URL=
PANDORA_LOG_LEVEL=INFO
PANDORA_RETENTION_DAYS=90
PANDORA_ENVELOPE_RETENTION_DAYS=7
PANDORA_INGEST_MAX_BYTES=1048576
PANDORA_RECONCILE_IGNORE=Watchdog,InfoInhibitor
PANDORA_AM_URL=
PANDORA_AM_CA_BUNDLE=
PANDORA_CONFIG=
PANDORA_SCRUB_ENABLED=1
PANDORA_SCRUB_ANONYMISE_IP=1
PANDORA_SCRUB_KEYWORDS=
PANDORA_SCRUB_SAFE_KEYS=
PANDORA_EMAIL_FROM=
PANDORA_OIDC_ISSUER=
PANDORA_OIDC_CLIENT_ID=
PANDORA_OIDC_CLIENT_SECRET=
PANDORA_OIDC_SCOPES=openid profile email
PANDORA_OIDC_GROUPS_CLAIM=groups
PANDORA_OIDC_TEAM=sso
PANDORA_OIDC_OWNER_GROUP=
PANDORA_OIDC_MEMBER_GROUP=
PANDORA_OIDC_VIEWER_GROUP=
PANDORA_OIDC_DEFAULT_ROLE=viewer
PANDORA_SPIKE_ENABLED=0
PANDORA_SPIKE_FACTOR=5
PANDORA_SPIKE_FLOOR=100
PANDORA_GROUPING_NORMALISE=0
PANDORA_BREADTH_KEYS=pod,node,instance,namespace
PANDORA_RETENTION_BY_RELEVANCE=0
PANDORA_RELEVANCE_BUDGET=500
PANDORA_RELEVANCE_HALF_LIFE_DAYS=7
PANDORA_ARCHIVE_DIR=
PANDORA_ARTIFACT_DIR=
PANDORA_CORRELATION_KEYS=namespace,pod,node,cluster,service
PANDORA_CORRELATION_WINDOW_MINUTES=60
PANDORA_GRAFANA_URL=
PANDORA_LOKI_QUERY_URL=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.test
DJANGO_SUPERUSER_PASSWORD=

# Host ports for `just up`. Empty means docker picks a free one — leave them
# empty in a worktree so several checkouts can run at once, and read the result
# back with `just url` and `just dburl`. Set one to pin a checkout to a
# predictable address. Nothing published by CI reads these.
PANDORA_WEB_PORT=
PANDORA_DB_PORT=
