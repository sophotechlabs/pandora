DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TRUST_PROXY_HEADER=0
DATABASE_URL=postgres://pandora:pandora@db:5432/pandora
PANDORA_ENV=local
PANDORA_BASE_URL=
PANDORA_LOG_LEVEL=INFO
PANDORA_RETENTION_DAYS=90
PANDORA_ENVELOPE_RETENTION_DAYS=7
PANDORA_INGEST_MAX_BYTES=1048576
PANDORA_RECONCILE_IGNORE=Watchdog,InfoInhibitor
PANDORA_AM_URL=
PANDORA_AM_CA_BUNDLE=
PANDORA_GRAFANA_URL=
PANDORA_LOKI_QUERY_URL=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.test
DJANGO_SUPERUSER_PASSWORD=

# Host ports for `just up`. Empty means docker picks a free one — leave them
# empty in a worktree so several checkouts can run at once, and read the result
# back with `just url` and `just dburl`. Set one to pin a checkout to a
# predictable address. Nothing published by CI reads these.
PANDORA_WEB_PORT=
PANDORA_DB_PORT=
